# --- LLM provider: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_WORKSPACE_ID=   # only if the key is not scoped to a workspace (wrkspc_...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Jev (TypeSafe AI)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# --- Catalog
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Pipeline
RERANKER=jev            # jev | llm_judge | none
CANDIDATES=15
TOP_K=5
MIN_CONFIDENCE=0.35     # below this, Jev's answer is flagged (not dropped)
REQUEST_TIMEOUT_S=20
LOG_LEVEL=INFO
